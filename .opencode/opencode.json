{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "data/**",
      "logs/**",
      ".venv/**",
      "**/*.db",
      "**/*.duckdb",
      "**/*.parquet",
      ".git/**",
      "node_modules/**",
      "workspace/**"
    ]
  },
  "permission": {
    "websearch": "deny",
    "webfetch": "deny"
  },
  "tools": {
    "websearch": false,
    "webfetch": false
  },
  "subagent_depth": 5
}
