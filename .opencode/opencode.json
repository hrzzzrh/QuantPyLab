{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "data/**",
      "logs/**",
      ".venv/**",
      "**/*.db",
      "**/*.duckdb",
      "**/*.parquet",
      ".git/**",
      "node_modules/**",
      "workspace/**"
    ]
  },
  "permission": {
    "websearch": "allow",
    "webfetch": "allow"
  },
  "tools": {
    "websearch": true,
    "webfetch": true
  },
  "experimental": {
    "subagent_depth": 5
  }
}
